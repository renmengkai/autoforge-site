---
import "../styles/global.css";

const lastUpdated = "2026 年 1 月 1 日";
const sections = [
  {
    id: "collect",
    title: "我们收集哪些信息",
    items: [
      {
        heading: "联系信息",
        body: "当您通过邮件（hello@autoforge.dev）或演示申请表与我们联系时，我们会收集您提供的姓名、电子邮件地址及相关沟通内容。"
      },
      {
        heading: "使用数据",
        body: "我们可能收集匿名的浏览行为数据，包括访问页面、停留时长和来源渠道，用于改进产品体验。这些数据不包含任何可识别个人身份的信息。"
      },
      {
        heading: "技术信息",
        body: "标准的服务器日志信息，包括 IP 地址（已匿名化）、浏览器类型和操作系统，用于安全监控和故障排查。"
      }
    ]
  },
  {
    id: "use",
    title: "我们如何使用信息",
    items: [
      {
        heading: "响应您的请求",
        body: "使用您提供的联系方式回复演示申请、技术咨询或业务合作请求。"
      },
      {
        heading: "产品改进",
        body: "基于聚合的匿名使用数据，持续优化 AutoForge 平台的功能和用户体验，不会将其用于任何广告目的。"
      },
      {
        heading: "安全保障",
        body: "检测和防范恶意访问、滥用行为及安全威胁，保护平台和用户数据的安全。"
      }
    ]
  },
  {
    id: "share",
    title: "信息共享原则",
    items: [
      {
        heading: "不出售数据",
        body: "我们不会出售、出租或以任何商业形式转让您的个人信息给第三方。"
      },
      {
        heading: "服务提供商",
        body: "仅在必要时与严格审核的技术服务商（如邮件发送服务）共享最小范围的数据，且这些服务商须遵守与我们同等级别的数据保护要求。"
      },
      {
        heading: "法律合规",
        body: "如法律法规明确要求，或为保护用户及公众的合法权益所必需，我们可能依法披露相关信息。"
      }
    ]
  },
  {
    id: "rights",
    title: "您的权利",
    items: [
      {
        heading: "访问与更正",
        body: "您有权随时请求访问、更正或删除我们持有的您的个人信息。"
      },
      {
        heading: "撤回同意",
        body: "如您曾同意接收我们的更新信息，可随时通过回复邮件的方式取消订阅。"
      },
      {
        heading: "数据可携带",
        body: "您可以请求以通用格式导出我们持有的您的数据。如需行使上述权利，请发送邮件至 hello@autoforge.dev。"
      }
    ]
  },
  {
    id: "security",
    title: "数据安全",
    items: [
      {
        heading: "传输加密",
        body: "所有与 AutoForge 平台的数据传输均通过 TLS/HTTPS 加密，防止中间人攻击。"
      },
      {
        heading: "最小化原则",
        body: "我们仅收集实现服务目的所必需的最少量数据，并定期审查和清理不再需要的数据。"
      },
      {
        heading: "访问控制",
        body: "内部系统实行严格的权限管理，仅授权人员可接触用户相关数据，且所有访问均留有审计记录。"
      }
    ]
  }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AutoForge 隐私政策 — 了解我们如何收集、使用和保护您的个人信息。" />
    <meta name="theme-color" content="#070707" />
    <link rel="icon" type="image/png" href="/autoforge-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>隐私政策 — AutoForge</title>
    <style>
      .legal-page {
        min-height: 100vh;
        padding-top: 8rem;
        padding-bottom: 8rem;
      }

      .legal-hero {
        padding-bottom: 5rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 5rem;
      }

      .legal-eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .legal-eyebrow a {
        color: var(--muted);
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        text-decoration: none;
        letter-spacing: 0.08em;
        transition: color 0.2s ease;
      }

      .legal-eyebrow a:hover {
        color: white;
      }

      .legal-eyebrow span {
        color: #3a3733;
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
      }

      .legal-eyebrow strong {
        color: var(--orange);
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.08em;
      }

      .legal-title {
        margin: 0 0 1.5rem;
        font-family: "Noto Sans SC", sans-serif;
        font-size: clamp(2.8rem, 6vw, 5.5rem);
        font-weight: 700;
        letter-spacing: -0.07em;
        line-height: 1;
        color: white;
      }

      .legal-meta {
        color: var(--muted);
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        letter-spacing: 0.06em;
      }

      .legal-meta span {
        color: #4e4a46;
        margin-right: 0.5rem;
      }

      .legal-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.38fr);
        gap: 6rem;
        align-items: start;
      }

      .legal-sections {
        display: grid;
        gap: 4rem;
      }

      .legal-section-title {
        margin: 0 0 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--line);
        color: white;
        font-family: "Geist", sans-serif;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.03em;
      }

      .legal-section-title::before {
        content: attr(data-index) " / ";
        color: #3a3733;
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        margin-right: 0.5rem;
      }

      .legal-items {
        display: grid;
        gap: 2rem;
      }

      .legal-item-heading {
        margin: 0 0 0.6rem;
        color: #c8c3be;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .legal-item-body {
        margin: 0;
        color: var(--muted);
        font-family: "Noto Sans SC", sans-serif;
        font-size: 1rem;
        line-height: 1.8;
        text-wrap: pretty;
      }

      .legal-sidebar {
        position: sticky;
        top: 7rem;
        display: grid;
        gap: 0.5rem;
      }

      .legal-sidebar-label {
        margin: 0 0 1rem;
        color: #4a4643;
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
      }

      .legal-sidebar a {
        display: block;
        padding: 0.55rem 0;
        color: #706a65;
        font-size: 0.875rem;
        text-decoration: none;
        border-left: 1px solid var(--line);
        padding-left: 1rem;
        transition: color 0.2s ease, border-color 0.2s ease;
      }

      .legal-sidebar a:hover {
        color: white;
        border-color: var(--orange);
      }

      .legal-contact-box {
        margin-top: 2.5rem;
        padding: 1.25rem;
        border: 1px solid var(--line);
        border-radius: 0.6rem;
        background: #0c0c0c;
      }

      .legal-contact-box p {
        margin: 0 0 0.9rem;
        color: #706a65;
        font-size: 0.875rem;
        line-height: 1.65;
      }

      .legal-contact-box a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--orange);
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        text-decoration: none;
        border-left: none;
        padding-left: 0;
        border: none;
        transition: color 0.2s ease;
      }

      .legal-contact-box a:hover {
        color: var(--orange-light);
        border: none;
      }

      @media (max-width: 900px) {
        .legal-body {
          grid-template-columns: 1fr;
          gap: 3rem;
        }

        .legal-sidebar {
          position: static;
          order: -1;
        }
      }
    </style>
  </head>
  <body>
    <div class="page-progress" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href="/" aria-label="AutoForge 首页">
        <img class="brand-logo" src="/autoforge-logo.png" alt="" />
        <span>Auto<span>Forge</span></span>
      </a>
      <nav class="desktop-nav" aria-label="主导航">
        <a href="/#platform">平台</a>
        <a href="/#engines">核心能力</a>
        <a href="/#workflow">完整周期</a>
        <a href="/#contact">联系我们</a>
      </nav>
      <div class="nav-actions">
        <a class="text-action" href="/#pipeline">查看运行状态</a>
        <a class="nav-button" href="/#contact">开始构建 <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main class="legal-page section-shell">
      <div class="legal-hero">
        <div class="legal-eyebrow">
          <a href="/">← 返回首页</a>
          <span>/</span>
          <strong>PRIVACY POLICY</strong>
        </div>
        <h1 class="legal-title">隐私政策</h1>
        <p class="legal-meta">
          <span>最后更新</span>{lastUpdated}
        </p>
      </div>

      <div class="legal-body">
        <div class="legal-sections">
          {sections.map((section, i) => (
            <section id={section.id}>
              <h2 class="legal-section-title" data-index={String(i + 1).padStart(2, "0")}>
                {section.title}
              </h2>
              <div class="legal-items">
                {section.items.map((item) => (
                  <div>
                    <h3 class="legal-item-heading">{item.heading}</h3>
                    <p class="legal-item-body">{item.body}</p>
                  </div>
                ))}
              </div>
            </section>
          ))}

          <section>
            <h2 class="legal-section-title" data-index="06">政策更新</h2>
            <div class="legal-items">
              <div>
                <h3 class="legal-item-heading">变更通知</h3>
                <p class="legal-item-body">
                  我们可能定期更新本隐私政策以反映产品变化或法规要求。重大变更将通过页面显著提示告知。继续使用 AutoForge 服务即表示您接受更新后的政策。如有疑问，请随时联系我们。
                </p>
              </div>
            </div>
          </section>
        </div>

        <aside class="legal-sidebar" aria-label="目录">
          <p class="legal-sidebar-label">目录</p>
          {sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))}
          <a href="#update">政策更新</a>

          <div class="legal-contact-box">
            <p>如对本政策有任何疑问，请联系我们的数据保护团队。</p>
            <a href="mailto:hello@autoforge.dev">hello@autoforge.dev ↗</a>
          </div>
        </aside>
      </div>
    </main>

    <footer>
      <div class="footer-main section-shell">
        <div>
          <a class="brand footer-brand" href="/">
            <img class="brand-logo" src="/autoforge-logo.png" alt="" />
            <span>Auto<span>Forge</span></span>
          </a>
          <p>八节点全链路 AI 软件工厂系统，完全替代传统外包。</p>
        </div>
        <div>
          <p class="footer-label">PLATFORM</p>
          <a href="/#platform">产品能力</a>
          <a href="/#engines">核心能力</a>
          <a href="/#workflow">完整产品周期</a>
        </div>
        <div>
          <p class="footer-label">COMPANY</p>
          <a href="mailto:hello@autoforge.dev">联系我们</a>
          <a href="/privacy">隐私政策</a>
          <a href="/terms">服务条款</a>
        </div>
        <div class="footer-status">
          <p class="footer-label">SYSTEM STATUS</p>
          <span><i></i> 所有系统运行正常</span>
        </div>
      </div>
      <div class="footer-bottom section-shell">
        <span>© 2026 AUTOFORGE. ALL RIGHTS RESERVED.</span>
        <span>DESIGNED FOR CONTINUOUS DELIVERY.</span>
      </div>
    </footer>

    <script>
      const header = document.querySelector(".site-header");
      const progress = document.querySelector(".page-progress");
      let previousScroll = 0;
      let ticking = false;

      const handleScroll = () => {
        const currentScroll = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (progress instanceof HTMLElement) {
          progress.style.transform = `scaleX(${maxScroll > 0 ? currentScroll / maxScroll : 0})`;
        }
        header?.classList.toggle("is-compact", currentScroll > 40);
        header?.classList.toggle("is-hidden", currentScroll > previousScroll && currentScroll > 180);
        previousScroll = currentScroll;
        ticking = false;
      };

      window.addEventListener("scroll", () => {
        if (!ticking) { requestAnimationFrame(handleScroll); ticking = true; }
      }, { passive: true });
    </script>
  </body>
</html>
