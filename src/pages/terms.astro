---
import "../styles/global.css";

const lastUpdated = "2026 年 1 月 1 日";
const sections = [
  {
    id: "service",
    title: "服务说明",
    items: [
      {
        heading: "AutoForge 平台",
        body: "AutoForge 是一套 AI 驱动的软件工厂系统，覆盖需求收集、物料管理、原型设计、Spec 审查、编码实现、系统测试、安全审查到部署上线的完整八节点交付链路。我们的服务旨在替代传统软件外包模式，通过 AI Agent 协作实现端到端的软件交付。"
      },
      {
        heading: "服务访问",
        body: "使用 AutoForge 平台即表示您同意本服务条款。我们保留在提前通知的情况下修改、暂停或终止服务的权利。对于正在进行中的项目，我们将提供合理的迁移期和数据导出支持。"
      },
      {
        heading: "账户责任",
        body: "您对在自己账户下发生的所有活动负责，包括通过 AutoForge 平台生成、提交和部署的代码及相关产物。请妥善保管您的访问凭证，及时报告任何未授权访问。"
      }
    ]
  },
  {
    id: "usage",
    title: "可接受使用规范",
    items: [
      {
        heading: "合法使用",
        body: "您同意仅将 AutoForge 用于合法的软件开发目的，遵守所有适用的法律法规，包括但不限于知识产权法、数据保护法和出口管制法规。"
      },
      {
        heading: "禁止行为",
        body: "严禁将平台用于生成恶意软件、参与未授权的安全测试（渗透测试需提前获得书面授权）、侵犯他人知识产权、传播虚假信息或从事任何违法违规活动。"
      },
      {
        heading: "资源使用",
        body: "请合理使用平台计算资源，不得进行任何形式的资源滥用、自动化批量操作或对系统稳定性造成负面影响的行为。如有大规模使用需求，请提前联系我们协商企业级方案。"
      }
    ]
  },
  {
    id: "ip",
    title: "知识产权",
    items: [
      {
        heading: "您的代码归您所有",
        body: "通过 AutoForge 平台生成的所有代码、文档和其他交付物的知识产权归您或您的组织所有。我们不主张对您通过平台产生的输出拥有任何所有权。"
      },
      {
        heading: "平台知识产权",
        body: "AutoForge 平台本身，包括其底层算法、工作流引擎、界面设计和品牌要素，受知识产权法保护，归 AutoForge 团队所有。您不得反向工程、复制或以其他方式滥用平台核心技术。"
      },
      {
        heading: "第三方组件",
        body: "AutoForge 集成了多种开源和第三方工具（如 Claude Code CLI、Open Design 等）。使用这些集成功能时，您同时受相关第三方服务条款约束。我们在文档中注明了主要集成组件的许可信息。"
      }
    ]
  },
  {
    id: "liability",
    title: "责任限制",
    items: [
      {
        heading: "服务保证",
        body: "AutoForge 平台按「现状」提供服务。虽然我们致力于保障服务质量和稳定性，但不对服务的中断、延迟或错误提供明示或暗示的保证。AI 生成的代码和建议应经过专业评审后方可用于生产环境。"
      },
      {
        heading: "损害赔偿上限",
        body: "在法律允许的最大范围内，AutoForge 对因使用或无法使用本服务所导致的任何间接、偶发、特殊或后果性损害不承担责任。我们的总责任上限不超过您在损害发生前三个月内支付给我们的费用金额。"
      },
      {
        heading: "代码部署责任",
        body: "通过 AutoForge 生成并部署到生产环境的代码，其安全性、合规性和功能正确性最终由您负责。我们提供安全审查工具和最佳实践建议，但不替代您的专业技术判断。"
      }
    ]
  },
  {
    id: "termination",
    title: "终止与暂停",
    items: [
      {
        heading: "您的终止权利",
        body: "您可以随时停止使用 AutoForge 服务。如需删除您的账户和相关数据，请发送请求至 hello@autoforge.dev，我们将在 30 个工作日内处理。"
      },
      {
        heading: "我们的终止权利",
        body: "如发现违反本服务条款的行为，我们有权暂停或终止您的服务访问，通常会提前通知，但严重违规情况除外。终止前产生的费用仍需结清。"
      },
      {
        heading: "数据处理",
        body: "服务终止后，我们将根据隐私政策的规定保留或删除您的数据。您在终止前可通过平台导出所有项目数据。"
      }
    ]
  }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="AutoForge 服务条款 — 了解使用我们 AI 软件工厂平台的权利与义务。" />
    <meta name="theme-color" content="#070707" />
    <link rel="icon" type="image/png" href="/autoforge-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>服务条款 — AutoForge</title>
    <style>
      .legal-page {
        min-height: 100vh;
        padding-top: 8rem;
        padding-bottom: 8rem;
      }

      .legal-hero {
        padding-bottom: 5rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 5rem;
      }

      .legal-eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .legal-eyebrow a {
        color: var(--muted);
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        text-decoration: none;
        letter-spacing: 0.08em;
        transition: color 0.2s ease;
      }

      .legal-eyebrow a:hover {
        color: white;
      }

      .legal-eyebrow span {
        color: #3a3733;
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
      }

      .legal-eyebrow strong {
        color: var(--orange);
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.08em;
      }

      .legal-title {
        margin: 0 0 1.5rem;
        font-family: "Noto Sans SC", sans-serif;
        font-size: clamp(2.8rem, 6vw, 5.5rem);
        font-weight: 700;
        letter-spacing: -0.07em;
        line-height: 1;
        color: white;
      }

      .legal-meta {
        color: var(--muted);
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        letter-spacing: 0.06em;
      }

      .legal-meta span {
        color: #4e4a46;
        margin-right: 0.5rem;
      }

      .legal-body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.38fr);
        gap: 6rem;
        align-items: start;
      }

      .legal-sections {
        display: grid;
        gap: 4rem;
      }

      .legal-section-title {
        margin: 0 0 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--line);
        color: white;
        font-family: "Geist", sans-serif;
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.03em;
      }

      .legal-section-title::before {
        content: attr(data-index) " / ";
        color: #3a3733;
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        margin-right: 0.5rem;
      }

      .legal-items {
        display: grid;
        gap: 2rem;
      }

      .legal-item-heading {
        margin: 0 0 0.6rem;
        color: #c8c3be;
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .legal-item-body {
        margin: 0;
        color: var(--muted);
        font-family: "Noto Sans SC", sans-serif;
        font-size: 1rem;
        line-height: 1.8;
        text-wrap: pretty;
      }

      .legal-sidebar {
        position: sticky;
        top: 7rem;
        display: grid;
        gap: 0.5rem;
      }

      .legal-sidebar-label {
        margin: 0 0 1rem;
        color: #4a4643;
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
      }

      .legal-sidebar a {
        display: block;
        padding: 0.55rem 0;
        color: #706a65;
        font-size: 0.875rem;
        text-decoration: none;
        border-left: 1px solid var(--line);
        padding-left: 1rem;
        transition: color 0.2s ease, border-color 0.2s ease;
      }

      .legal-sidebar a:hover {
        color: white;
        border-color: var(--orange);
      }

      .legal-contact-box {
        margin-top: 2.5rem;
        padding: 1.25rem;
        border: 1px solid var(--line);
        border-radius: 0.6rem;
        background: #0c0c0c;
      }

      .legal-contact-box p {
        margin: 0 0 0.9rem;
        color: #706a65;
        font-size: 0.875rem;
        line-height: 1.65;
      }

      .legal-contact-box a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--orange);
        font-family: "Geist Mono", monospace;
        font-size: 0.8rem;
        text-decoration: none;
        border-left: none;
        padding-left: 0;
        border: none;
        transition: color 0.2s ease;
      }

      .legal-contact-box a:hover {
        color: var(--orange-light);
        border: none;
      }

      @media (max-width: 900px) {
        .legal-body {
          grid-template-columns: 1fr;
          gap: 3rem;
        }

        .legal-sidebar {
          position: static;
          order: -1;
        }
      }
    </style>
  </head>
  <body>
    <div class="page-progress" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href="/" aria-label="AutoForge 首页">
        <img class="brand-logo" src="/autoforge-logo.png" alt="" />
        <span>Auto<span>Forge</span></span>
      </a>
      <nav class="desktop-nav" aria-label="主导航">
        <a href="/#platform">平台</a>
        <a href="/#engines">核心能力</a>
        <a href="/#workflow">完整周期</a>
        <a href="/#contact">联系我们</a>
      </nav>
      <div class="nav-actions">
        <a class="text-action" href="/#pipeline">查看运行状态</a>
        <a class="nav-button" href="/#contact">开始构建 <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main class="legal-page section-shell">
      <div class="legal-hero">
        <div class="legal-eyebrow">
          <a href="/">← 返回首页</a>
          <span>/</span>
          <strong>TERMS OF SERVICE</strong>
        </div>
        <h1 class="legal-title">服务条款</h1>
        <p class="legal-meta">
          <span>最后更新</span>{lastUpdated}
        </p>
      </div>

      <div class="legal-body">
        <div class="legal-sections">
          {sections.map((section, i) => (
            <section id={section.id}>
              <h2 class="legal-section-title" data-index={String(i + 1).padStart(2, "0")}>
                {section.title}
              </h2>
              <div class="legal-items">
                {section.items.map((item) => (
                  <div>
                    <h3 class="legal-item-heading">{item.heading}</h3>
                    <p class="legal-item-body">{item.body}</p>
                  </div>
                ))}
              </div>
            </section>
          ))}

          <section>
            <h2 class="legal-section-title" data-index="06">适用法律与争议解决</h2>
            <div class="legal-items">
              <div>
                <h3 class="legal-item-heading">适用法律</h3>
                <p class="legal-item-body">
                  本服务条款受中华人民共和国法律管辖并依其解释。如发生争议，双方应首先通过友好协商解决。协商不成时，提交有管辖权的人民法院依法诉讼解决。如您有任何疑问，请随时联系 hello@autoforge.dev。
                </p>
              </div>
            </div>
          </section>
        </div>

        <aside class="legal-sidebar" aria-label="目录">
          <p class="legal-sidebar-label">目录</p>
          {sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))}
          <a href="#dispute">适用法律与争议解决</a>

          <div class="legal-contact-box">
            <p>如对本条款有任何疑问或需要法律相关支持，请联系我们。</p>
            <a href="mailto:hello@autoforge.dev">hello@autoforge.dev ↗</a>
          </div>
        </aside>
      </div>
    </main>

    <footer>
      <div class="footer-main section-shell">
        <div>
          <a class="brand footer-brand" href="/">
            <img class="brand-logo" src="/autoforge-logo.png" alt="" />
            <span>Auto<span>Forge</span></span>
          </a>
          <p>八节点全链路 AI 软件工厂系统，完全替代传统外包。</p>
        </div>
        <div>
          <p class="footer-label">PLATFORM</p>
          <a href="/#platform">产品能力</a>
          <a href="/#engines">核心能力</a>
          <a href="/#workflow">完整产品周期</a>
        </div>
        <div>
          <p class="footer-label">COMPANY</p>
          <a href="mailto:hello@autoforge.dev">联系我们</a>
          <a href="/privacy">隐私政策</a>
          <a href="/terms">服务条款</a>
        </div>
        <div class="footer-status">
          <p class="footer-label">SYSTEM STATUS</p>
          <span><i></i> 所有系统运行正常</span>
        </div>
      </div>
      <div class="footer-bottom section-shell">
        <span>© 2026 AUTOFORGE. ALL RIGHTS RESERVED.</span>
        <span>DESIGNED FOR CONTINUOUS DELIVERY.</span>
      </div>
    </footer>

    <script>
      const header = document.querySelector(".site-header");
      const progress = document.querySelector(".page-progress");
      let previousScroll = 0;
      let ticking = false;

      const handleScroll = () => {
        const currentScroll = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (progress instanceof HTMLElement) {
          progress.style.transform = `scaleX(${maxScroll > 0 ? currentScroll / maxScroll : 0})`;
        }
        header?.classList.toggle("is-compact", currentScroll > 40);
        header?.classList.toggle("is-hidden", currentScroll > previousScroll && currentScroll > 180);
        previousScroll = currentScroll;
        ticking = false;
      };

      window.addEventListener("scroll", () => {
        if (!ticking) { requestAnimationFrame(handleScroll); ticking = true; }
      }, { passive: true });
    </script>
  </body>
</html>
