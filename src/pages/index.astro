    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const root = document.documentElement;
      const loader = document.querySelector(".loader");
      const loaderPercent = document.querySelector(".loader-percent");
      const loaderTrack = document.querySelector(".loader-track span");

      let loadValue = 0;
      const loadTimer = window.setInterval(() => {
        loadValue = Math.min(100, loadValue + Math.ceil(Math.random() * 14));
        if (loaderPercent) loaderPercent.textContent = String(loadValue).padStart(2, "0");
        if (loaderTrack instanceof HTMLElement) loaderTrack.style.transform = `scaleX(${loadValue / 100})`;
        if (loadValue >= 100) {
          window.clearInterval(loadTimer);
          window.setTimeout(() => loader?.classList.add("is-hidden"), reducedMotion ? 0 : 280);
        }
      }, reducedMotion ? 20 : 70);

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((element) => revealObserver.observe(element));

      // Decode / scramble effect on mono eyebrow labels as they enter view
      const scrambleGlyphs = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#/<>";
      const runScramble = (element: HTMLElement) => {
        const finalText = element.textContent ?? "";
        const length = finalText.length;
        const totalFrames = 26;
        let frame = 0;
        const tick = () => {
          let output = "";
          for (let i = 0; i < length; i += 1) {
            const char = finalText[i];
            if (char === " ") {
              output += " ";
              continue;
            }
            const revealFrame = (i / length) * totalFrames * 0.7;
            output +=
              frame >= revealFrame
                ? char
                : scrambleGlyphs[Math.floor(Math.random() * scrambleGlyphs.length)];
          }
          element.textContent = output;
          frame += 1;
          if (frame <= totalFrames) requestAnimationFrame(tick);
          else element.textContent = finalText;
        };
        tick();
      };

      if (!reducedMotion) {
        const scrambleObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              if (entry.target instanceof HTMLElement) runScramble(entry.target);
              scrambleObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.85 }
        );
        document.querySelectorAll(".eyebrow").forEach((element) => scrambleObserver.observe(element));
      }

      document.querySelectorAll("[data-count]").forEach((element) => {
        const target = Number(element.getAttribute("data-count"));
        const counterObserver = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            if (reducedMotion) {
              element.textContent = String(target);
            } else {
              const start = performance.now();
              const update = (now: number) => {
                const progress = Math.min((now - start) / 1300, 1);
                const eased = 1 - Math.pow(1 - progress, 4);
                element.textContent = String(Math.round(target * eased));
                if (progress < 1) requestAnimationFrame(update);
              };
              requestAnimationFrame(update);
            }
            counterObserver.disconnect();
          },
          { threshold: 0.6 }
        );
        counterObserver.observe(element);
      });

      const header = document.querySelector(".site-header");
      const progress = document.querySelector(".page-progress");
      let previousScroll = 0;
      let ticking = false;

      const handleScroll = () => {
        const currentScroll = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const heroProgress = Math.min(currentScroll / Math.max(window.innerHeight, 1), 1);
        if (progress instanceof HTMLElement) {
          progress.style.transform = `scaleX(${maxScroll > 0 ? currentScroll / maxScroll : 0})`;
        }
        header?.classList.toggle("is-compact", currentScroll > 40);
        header?.classList.toggle(
          "is-hidden",
          currentScroll > previousScroll && currentScroll > 180 && !document.body.classList.contains("menu-open")
        );
        root.style.setProperty("--hero-shift", `${Math.min(currentScroll * 0.08, 42)}px`);
        root.style.setProperty("--hero-progress", String(heroProgress));
        root.style.setProperty("--hero-motion-opacity", String(1 - heroProgress * 0.72));
        previousScroll = currentScroll;
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            requestAnimationFrame(handleScroll);
            ticking = true;
          }
        },
        { passive: true }
      );

      const navLinks = document.querySelectorAll('.desktop-nav a[href^="#"]');
      const observedSections = [...navLinks]
        .map((link) => document.querySelector(link.getAttribute("href") || ""))
        .filter((section): section is Element => section !== null);
      const navObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            navLinks.forEach((link) => {
              link.classList.toggle("is-active", link.getAttribute("href") === `#${entry.target.id}`);
            });
          });
        },
        { rootMargin: "-25% 0px -65% 0px", threshold: 0 }
      );
      observedSections.forEach((section) => navObserver.observe(section));

      // Scroll-linked workflow: light up the node at viewport center, fill the spine
      const workflowArticles = Array.from(document.querySelectorAll(".workflow-track article"));
      const workflowTrackEl = document.querySelector(".workflow-track");
      if (workflowArticles.length && workflowTrackEl instanceof HTMLElement) {
        let maxReached = -1;
        const workflowObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const index = workflowArticles.indexOf(entry.target);
              if (entry.isIntersecting) {
                entry.target.classList.add("is-active");
                if (index > maxReached) {
                  maxReached = index;
                  workflowTrackEl.style.setProperty(
                    "--wf-progress",
                    ((maxReached + 1) / workflowArticles.length).toFixed(3)
                  );
                }
              } else {
                entry.target.classList.remove("is-active");
              }
            });
          },
          { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
        );
        workflowArticles.forEach((article) => workflowObserver.observe(article));
      }

      const menuToggle = document.querySelector(".menu-toggle");
      const mobileNav = document.querySelector(".mobile-nav");
      menuToggle?.addEventListener("click", () => {
        const open = document.body.classList.toggle("menu-open");
        menuToggle.setAttribute("aria-expanded", String(open));
      });
      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          document.body.classList.remove("menu-open");
          menuToggle?.setAttribute("aria-expanded", "false");
        });
      });

      const pointerTarget = { x: 0, y: 0 };
      if (window.matchMedia("(pointer: fine)").matches) {
        window.addEventListener("pointermove", (event) => {
          root.style.setProperty("--pointer-x", `${event.clientX}px`);
          root.style.setProperty("--pointer-y", `${event.clientY}px`);
          pointerTarget.x = event.clientX / window.innerWidth - 0.5;
          pointerTarget.y = event.clientY / window.innerHeight - 0.5;
        });

        document.querySelectorAll(".spotlight-card").forEach((card) => {
          card.addEventListener("pointermove", (event) => {
            const pointerEvent = event as PointerEvent;
            const bounds = card.getBoundingClientRect();
            if (card instanceof HTMLElement) {
              card.style.setProperty("--mx", `${pointerEvent.clientX - bounds.left}px`);
              card.style.setProperty("--my", `${pointerEvent.clientY - bounds.top}px`);
            }
          });
        });

        if (!reducedMotion) {
          document.querySelectorAll(".magnetic").forEach((element) => {
            element.addEventListener("pointermove", (event) => {
              const pointerEvent = event as PointerEvent;
              const bounds = element.getBoundingClientRect();
              const x = pointerEvent.clientX - bounds.left - bounds.width / 2;
              const y = pointerEvent.clientY - bounds.top - bounds.height / 2;
              if (element instanceof HTMLElement) {
                element.style.transform = `translate(${x * 0.08}px, ${y * 0.08}px)`;
              }
            });
            element.addEventListener("pointerleave", () => {
              if (element instanceof HTMLElement) element.style.transform = "";
            });
          });

          // 3D parallax tilt on cards
          document.querySelectorAll(".tilt").forEach((card) => {
            if (!(card instanceof HTMLElement)) return;
            const max = Number(card.getAttribute("data-tilt")) || 6;
            card.addEventListener("pointermove", (event) => {
              const pointerEvent = event as PointerEvent;
              const bounds = card.getBoundingClientRect();
              const px = (pointerEvent.clientX - bounds.left) / bounds.width - 0.5;
              const py = (pointerEvent.clientY - bounds.top) / bounds.height - 0.5;
              card.style.transform =
                `perspective(1100px) rotateX(${(-py * max).toFixed(2)}deg) ` +
                `rotateY(${(px * max).toFixed(2)}deg) translateY(-0.4rem)`;
            });
            card.addEventListener("pointerleave", () => {
              card.style.transform = "";
            });
          });
        }
      }

      // ---- Bilingual (ZH / EN) ----
      const I18N_STORE = "af-lang";
      const langToggle = document.querySelector(".lang-toggle");
      const i18nEls = Array.from(document.querySelectorAll("[data-en]")) as HTMLElement[];
      i18nEls.forEach((el) => {
        el.dataset.zh = el.innerHTML;
      });

      const consoleMessages = {
        zh: [
          "需求 Agent 正在分析 Issue，生成验收标准…",
          "物料整理完成，Spec 已生成，等待人工审核…",
          "Claude Code 编码完成，测试 Agent 验证中…",
          "安全审查通过，一键部署脚本已生成。"
        ],
        en: [
          "Requirement Agent is parsing the issue and drafting acceptance criteria…",
          "Materials curated, spec generated, awaiting human review…",
          "Claude Code finished the implementation, testing Agent verifying…",
          "Security review passed, one-click deploy script is ready."
        ]
      };

      let lang: "zh" | "en" = localStorage.getItem(I18N_STORE) === "en" ? "en" : "zh";
      let messageIndex = 0;

      const applyLang = (next: "zh" | "en") => {
        lang = next;
        document.documentElement.lang = next === "en" ? "en" : "zh-CN";
        document.title =
          next === "en" ? "AutoForge — AI Software Factory" : "AutoForge — AI 软件工厂系统";
        document.body.classList.toggle("lang-en", next === "en");
        i18nEls.forEach((el) => {
          const value = next === "en" ? el.dataset.en : el.dataset.zh;
          if (value != null) el.innerHTML = value;
        });
        if (langToggle) langToggle.textContent = next === "en" ? "中文" : "EN";
        const copyEl = document.querySelector(".console-copy");
        if (copyEl) copyEl.textContent = consoleMessages[next][messageIndex % consoleMessages[next].length];
      };

      applyLang(lang);
      langToggle?.addEventListener("click", () => {
        applyLang(lang === "en" ? "zh" : "en");
        localStorage.setItem(I18N_STORE, lang);
      });

      const consoleTime = document.querySelector(".console-time");
      const consoleCopy = document.querySelector(".console-copy");
      const liveRate = document.querySelector("[data-live-rate]");

      const formatLocalTime = () => {
        const now = new Date();
        return [
          String(now.getHours()).padStart(2, "0"),
          String(now.getMinutes()).padStart(2, "0"),
          String(now.getSeconds()).padStart(2, "0")
        ].join(":");
      };

      const briefMeta = document.querySelector(".brief-meta span:last-child");
      const updateClock = () => {
        const t = formatLocalTime();
        if (briefMeta) briefMeta.textContent = `${t} UTC+8`;
      };
      updateClock();
      window.setInterval(updateClock, 1000);

      const pnodes = Array.from(document.querySelectorAll(".pnode"));

      if (!reducedMotion) {
        window.setInterval(() => {
          messageIndex = (messageIndex + 1) % consoleMessages[lang].length;
          const copy = consoleMessages[lang][messageIndex];
          if (consoleCopy instanceof HTMLElement) {
            consoleCopy.style.opacity = "0";
            consoleCopy.style.transform = "translateY(0.4rem)";
            window.setTimeout(() => {
              consoleCopy.textContent = copy;
              consoleCopy.style.opacity = "1";
              consoleCopy.style.transform = "translateY(0)";
            }, 220);
          }
          if (consoleTime) consoleTime.textContent = formatLocalTime();
        }, 3000);
        window.setInterval(() => {
          if (liveRate) liveRate.textContent = (17 + Math.random() * 3.4).toFixed(1);
        }, 1400);

        // Pipeline: cycle the live node along the 8-node chain
        if (pnodes.length) {
          let liveNode = 0;
          pnodes[0].classList.add("is-live");
          window.setInterval(() => {
            pnodes[liveNode].classList.remove("is-live");
            liveNode = (liveNode + 1) % pnodes.length;
            pnodes[liveNode].classList.add("is-live");
          }, 1100);
        }
      } else {
        if (consoleCopy) consoleCopy.textContent = consoleMessages[lang][0];
        if (consoleTime) consoleTime.textContent = formatLocalTime();
        pnodes.forEach((node) => node.classList.add("is-live"));
      }

      // ---- Pipeline River ----
      // Left→right particle river representing work flowing through the 8-node
      // pipeline. Primary lanes are near-horizontal (engineered); secondary lanes
      // curve gently (organic variation). Hot packets (18%) carry a near-white
      // corona. Eight gate markers pulse in sequence at pipeline node cadence.
      const canvas = document.querySelector("#speed-field");
      if (canvas instanceof HTMLCanvasElement) {
        const ctx = canvas.getContext("2d");

        type Stream = {
          start: { x: number; y: number };
          cp0:   { x: number; y: number };
          cp1:   { x: number; y: number };
          end:   { x: number; y: number };
          alpha: number;
          width: number;
          hue:   number;
          main:  boolean;
        };
        type Dot = {
          si:   number;
          t:    number;
          spd:  number;   // progress per ms
          tail: number;
          sz:   number;
          a:    number;
          hue:  number;
          hot:  boolean;
          glow: boolean;
        };

        const streams: Stream[]                     = [];
        const dots: Dot[]                           = [];
        const gates: { x: number; pulse: number }[] = [];
        let W = 0, H = 0, dpr = 1, raf = 0, prevT = 0;
        let gateSeq = 0, gateMs = 0;
        const GATE_MS = 1100;

        const r = (a: number, b: number) => a + Math.random() * (b - a);

        const bez = (s: Stream, t: number) => {
          const u = 1 - t;
          return {
            x: u**3*s.start.x + 3*u**2*t*s.cp0.x + 3*u*t**2*s.cp1.x + t**3*s.end.x,
            y: u**3*s.start.y + 3*u**2*t*s.cp0.y + 3*u*t**2*s.cp1.y + t**3*s.end.y
          };
        };

        const buildStreams = () => {
          streams.length = 0;
          const N = W < 760 ? 16 : 28;
          for (let i = 0; i < N; i++) {
            const ratio   = i / (N - 1);
            const yBase   = H * (0.04 + ratio * 0.92);
            const main    = (i % 3 === 1);
            const maxAmp  = main ? 0.042 : 0.12;
            const sign    = Math.random() > 0.5 ? 1 : -1;
            const amp     = r(0.01, maxAmp) * H * sign;
            streams.push({
              start: { x: -65,    y: yBase + r(-0.022, 0.022) * H },
              cp0:   { x: W*0.27, y: yBase + amp                   },
              cp1:   { x: W*0.73, y: yBase - amp * 0.44            },
              end:   { x: W + 65, y: yBase + r(-0.022, 0.022) * H },
              alpha: main ? r(0.045, 0.095) : r(0.015, 0.052),
              width: main ? r(0.55,  1.05)  : r(0.22,  0.70),
              hue:   r(21, 34),
              main
            });
          }
        };

        const buildGates = () => {
          gates.length = 0;
          for (let k = 1; k <= 8; k++) gates.push({ x: W * k / 9, pulse: 0 });
        };

        const spawnDot = (d: Dot, stagger = false) => {
          d.si   = Math.floor(Math.random() * streams.length);
          d.t    = stagger ? Math.random() : r(-0.08, -0.01);
          d.hot  = Math.random() > 0.82;
          if (d.hot) {
            d.spd  = r(0.000110, 0.000340);
            d.tail = r(0.038, 0.088);
            d.sz   = r(0.75, 1.85);
            d.a    = r(0.55, 0.94);
            d.hue  = r(34, 52);
            d.glow = true;
          } else {
            d.spd  = r(0.000068, 0.000210);
            d.tail = r(0.032, 0.106);
            d.sz   = r(0.48, 2.1);
            d.a    = r(0.22, 0.86);
            d.hue  = r(19, 42);
            d.glow = Math.random() > 0.66;
          }
        };

        const resize = () => {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = canvas.clientWidth;
          H = canvas.clientHeight;
          canvas.width  = W * dpr;
          canvas.height = H * dpr;
          ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
          buildStreams();
          buildGates();
          const n = W < 760 ? 64 : Math.min(158, Math.round(W / 10));
          dots.length = 0;
          for (let i = 0; i < n; i++) {
            const d = {} as Dot;
            spawnDot(d, true);
            dots.push(d);
          }
        };

        const paintStream = (s: Stream) => {
          if (!ctx) return;
          ctx.beginPath();
          ctx.moveTo(s.start.x, s.start.y);
          ctx.bezierCurveTo(s.cp0.x, s.cp0.y, s.cp1.x, s.cp1.y, s.end.x, s.end.y);
          ctx.strokeStyle = `hsla(${s.hue}, ${s.main ? 86 : 74}%, ${s.main ? 57 : 52}%, ${s.alpha})`;
          ctx.lineWidth   = s.width;
          ctx.stroke();
        };

        const paintGates = () => {
          if (!ctx) return;
          for (const gate of gates) {
            if (gate.pulse < 0.005) continue;
            const a = gate.pulse * 0.28;
            const g = ctx.createLinearGradient(gate.x, 0, gate.x, H);
            g.addColorStop(0,    `rgba(255,168,62,0)`);
            g.addColorStop(0.18, `rgba(255,168,62,${a})`);
            g.addColorStop(0.50, `rgba(255,224,130,${a * 1.5})`);
            g.addColorStop(0.82, `rgba(255,168,62,${a})`);
            g.addColorStop(1,    `rgba(255,168,62,0)`);
            ctx.fillStyle = g;
            ctx.fillRect(gate.x - 1.5, 0, 3, H);
          }
        };

        const paintDot = (d: Dot) => {
          if (!ctx || d.t <= 0 || d.t > 1.02) return;
          const s    = streams[d.si];
          const SEGS = d.hot ? 13 : 10;
          const t0   = Math.max(0, d.t - d.tail);
          for (let k = 0; k < SEGS; k++) {
            const ta  = t0 + (d.t - t0) * (k / SEGS);
            const tb  = t0 + (d.t - t0) * ((k + 1) / SEGS);
            const pa  = bez(s, ta);
            const pb  = bez(s, tb);
            const itx = (k + 1) / SEGS;
            let lum = 44 + itx * 32;
            let sat = 100;
            if (d.hot && itx > 0.75) { lum = 64 + itx * 22; sat = 86 - itx * 24; }
            ctx.beginPath();
            ctx.moveTo(pa.x, pa.y);
            ctx.lineTo(pb.x, pb.y);
            ctx.strokeStyle = `hsla(${d.hue + itx * 9}, ${sat}%, ${lum}%, ${d.a * itx ** 1.65})`;
            ctx.lineWidth   = d.sz * (0.28 + itx * 1.02);
            ctx.lineCap     = "round";
            ctx.stroke();
          }
          if (d.glow) {
            const fade = Math.min(d.t / 0.06, 1) * Math.min((1.02 - d.t) / 0.06, 1);
            const head = bez(s, d.t);
            if (d.hot) {
              const radius = (2.8 + d.t * (1 - d.t) * 9) * fade;
              if (radius > 0.3) {
                const g = ctx.createRadialGradient(head.x, head.y, 0, head.x, head.y, radius);
                g.addColorStop(0,    "rgba(255,255,245,0.96)");
                g.addColorStop(0.18, "rgba(255,232,165,0.84)");
                g.addColorStop(0.52, "rgba(255,118,14,0.42)");
                g.addColorStop(1,    "rgba(255,52,0,0)");
                ctx.fillStyle = g;
                ctx.fillRect(head.x - radius, head.y - radius, radius * 2, radius * 2);
              }
            } else {
              const radius = (1.7 + d.t * (1 - d.t) * 5) * fade;
              if (radius > 0.3) {
                const g = ctx.createRadialGradient(head.x, head.y, 0, head.x, head.y, radius);
                g.addColorStop(0,    "rgba(255,224,158,0.88)");
                g.addColorStop(0.32, "rgba(255,128,26,0.50)");
                g.addColorStop(1,    "rgba(255,72,0,0)");
                ctx.fillStyle = g;
                ctx.fillRect(head.x - radius, head.y - radius, radius * 2, radius * 2);
              }
            }
          }
        };

        const draw = (ts: number) => {
          if (!ctx) return;
          const dt = Math.min(ts - prevT, 48);
          prevT    = ts;

          ctx.clearRect(0, 0, W, H);

          // Wide ambient glow — covers the full visible canvas height
          const gx  = W * 0.60, gy = H * 0.48;
          const amb = ctx.createRadialGradient(gx, gy, 0, gx, gy, W * 0.62);
          amb.addColorStop(0,    "rgba(255,82,5,0.11)");
          amb.addColorStop(0.36, "rgba(140,36,0,0.05)");
          amb.addColorStop(0.72, "rgba(4,16,48,0.025)");
          amb.addColorStop(1,    "rgba(0,0,0,0)");
          ctx.fillStyle = amb;
          ctx.fillRect(0, 0, W, H);

          // Advance gate cycle (left→right sweep, matches pipeline node cadence)
          gateMs += dt;
          if (gateMs >= GATE_MS) {
            gateMs -= GATE_MS;
            gates[gateSeq % gates.length].pulse = 1;
            gateSeq++;
          }
          const decay = dt / 500;
          for (const gate of gates) gate.pulse = Math.max(0, gate.pulse - decay);

          paintGates();
          streams.forEach(paintStream);

          for (const d of dots) {
            d.t += d.spd * dt;
            paintDot(d);
            if (d.t > 1.14) spawnDot(d);
          }

          if (!reducedMotion) raf = requestAnimationFrame(draw);
        };

        resize();
        window.addEventListener("resize", resize);
        prevT = performance.now();
        if (!reducedMotion) requestAnimationFrame(draw);
        else draw(prevT);
      }
    </script>
  </body>
</html>
