    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const root = document.documentElement;
      const loader = document.querySelector(".loader");
      const loaderPercent = document.querySelector(".loader-percent");
      const loaderTrack = document.querySelector(".loader-track span");

      let loadValue = 0;
      const loadTimer = window.setInterval(() => {
        loadValue = Math.min(100, loadValue + Math.ceil(Math.random() * 14));
        if (loaderPercent) loaderPercent.textContent = String(loadValue).padStart(2, "0");
        if (loaderTrack instanceof HTMLElement) loaderTrack.style.transform = `scaleX(${loadValue / 100})`;
        if (loadValue >= 100) {
          window.clearInterval(loadTimer);
          window.setTimeout(() => loader?.classList.add("is-hidden"), reducedMotion ? 0 : 280);
        }
      }, reducedMotion ? 20 : 70);

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.14, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal").forEach((element) => revealObserver.observe(element));

      // Decode / scramble effect on mono eyebrow labels as they enter view
      const scrambleGlyphs = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#/<>";
      const runScramble = (element: HTMLElement) => {
        const finalText = element.textContent ?? "";
        const length = finalText.length;
        const totalFrames = 26;
        let frame = 0;
        const tick = () => {
          let output = "";
          for (let i = 0; i < length; i += 1) {
            const char = finalText[i];
            if (char === " ") {
              output += " ";
              continue;
            }
            const revealFrame = (i / length) * totalFrames * 0.7;
            output +=
              frame >= revealFrame
                ? char
                : scrambleGlyphs[Math.floor(Math.random() * scrambleGlyphs.length)];
          }
          element.textContent = output;
          frame += 1;
          if (frame <= totalFrames) requestAnimationFrame(tick);
          else element.textContent = finalText;
        };
        tick();
      };

      if (!reducedMotion) {
        const scrambleObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              if (entry.target instanceof HTMLElement) runScramble(entry.target);
              scrambleObserver.unobserve(entry.target);
            });
          },
          { threshold: 0.85 }
        );
        document.querySelectorAll(".eyebrow").forEach((element) => scrambleObserver.observe(element));
      }

      document.querySelectorAll("[data-count]").forEach((element) => {
        const target = Number(element.getAttribute("data-count"));
        const counterObserver = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            if (reducedMotion) {
              element.textContent = String(target);
            } else {
              const start = performance.now();
              const update = (now: number) => {
                const progress = Math.min((now - start) / 1300, 1);
                const eased = 1 - Math.pow(1 - progress, 4);
                element.textContent = String(Math.round(target * eased));
                if (progress < 1) requestAnimationFrame(update);
              };
              requestAnimationFrame(update);
            }
            counterObserver.disconnect();
          },
          { threshold: 0.6 }
        );
        counterObserver.observe(element);
      });

      const header = document.querySelector(".site-header");
      const progress = document.querySelector(".page-progress");
      let previousScroll = 0;
      let ticking = false;

      const handleScroll = () => {
        const currentScroll = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const heroProgress = Math.min(currentScroll / Math.max(window.innerHeight, 1), 1);
        if (progress instanceof HTMLElement) {
          progress.style.transform = `scaleX(${maxScroll > 0 ? currentScroll / maxScroll : 0})`;
        }
        header?.classList.toggle("is-compact", currentScroll > 40);
        header?.classList.toggle(
          "is-hidden",
          currentScroll > previousScroll && currentScroll > 180 && !document.body.classList.contains("menu-open")
        );
        root.style.setProperty("--hero-shift", `${Math.min(currentScroll * 0.08, 42)}px`);
        root.style.setProperty("--hero-progress", String(heroProgress));
        root.style.setProperty("--hero-motion-opacity", String(1 - heroProgress * 0.72));
        previousScroll = currentScroll;
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            requestAnimationFrame(handleScroll);
            ticking = true;
          }
        },
        { passive: true }
      );

      const navLinks = document.querySelectorAll('.desktop-nav a[href^="#"]');
      const observedSections = [...navLinks]
        .map((link) => document.querySelector(link.getAttribute("href") || ""))
        .filter((section): section is Element => section !== null);
      const navObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            navLinks.forEach((link) => {
              link.classList.toggle("is-active", link.getAttribute("href") === `#${entry.target.id}`);
            });
          });
        },
        { rootMargin: "-25% 0px -65% 0px", threshold: 0 }
      );
      observedSections.forEach((section) => navObserver.observe(section));

      // Scroll-linked workflow: light up the node at viewport center, fill the spine
      const workflowArticles = Array.from(document.querySelectorAll(".workflow-track article"));
      const workflowTrackEl = document.querySelector(".workflow-track");
      if (workflowArticles.length && workflowTrackEl instanceof HTMLElement) {
        let maxReached = -1;
        const workflowObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const index = workflowArticles.indexOf(entry.target);
              if (entry.isIntersecting) {
                entry.target.classList.add("is-active");
                if (index > maxReached) {
                  maxReached = index;
                  workflowTrackEl.style.setProperty(
                    "--wf-progress",
                    ((maxReached + 1) / workflowArticles.length).toFixed(3)
                  );
                }
              } else {
                entry.target.classList.remove("is-active");
              }
            });
          },
          { rootMargin: "-45% 0px -45% 0px", threshold: 0 }
        );
        workflowArticles.forEach((article) => workflowObserver.observe(article));
      }

      const menuToggle = document.querySelector(".menu-toggle");
      const mobileNav = document.querySelector(".mobile-nav");
      menuToggle?.addEventListener("click", () => {
        const open = document.body.classList.toggle("menu-open");
        menuToggle.setAttribute("aria-expanded", String(open));
      });
      mobileNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          document.body.classList.remove("menu-open");
          menuToggle?.setAttribute("aria-expanded", "false");
        });
      });

      const pointerTarget = { x: 0, y: 0 };
      if (window.matchMedia("(pointer: fine)").matches) {
        window.addEventListener("pointermove", (event) => {
          root.style.setProperty("--pointer-x", `${event.clientX}px`);
          root.style.setProperty("--pointer-y", `${event.clientY}px`);
          pointerTarget.x = event.clientX / window.innerWidth - 0.5;
          pointerTarget.y = event.clientY / window.innerHeight - 0.5;
        });

        document.querySelectorAll(".spotlight-card").forEach((card) => {
          card.addEventListener("pointermove", (event) => {
            const pointerEvent = event as PointerEvent;
            const bounds = card.getBoundingClientRect();
            if (card instanceof HTMLElement) {
              card.style.setProperty("--mx", `${pointerEvent.clientX - bounds.left}px`);
              card.style.setProperty("--my", `${pointerEvent.clientY - bounds.top}px`);
            }
          });
        });

        if (!reducedMotion) {
          document.querySelectorAll(".magnetic").forEach((element) => {
            element.addEventListener("pointermove", (event) => {
              const pointerEvent = event as PointerEvent;
              const bounds = element.getBoundingClientRect();
              const x = pointerEvent.clientX - bounds.left - bounds.width / 2;
              const y = pointerEvent.clientY - bounds.top - bounds.height / 2;
              if (element instanceof HTMLElement) {
                element.style.transform = `translate(${x * 0.08}px, ${y * 0.08}px)`;
              }
            });
            element.addEventListener("pointerleave", () => {
              if (element instanceof HTMLElement) element.style.transform = "";
            });
          });

          // 3D parallax tilt on cards
          document.querySelectorAll(".tilt").forEach((card) => {
            if (!(card instanceof HTMLElement)) return;
            const max = Number(card.getAttribute("data-tilt")) || 6;
            card.addEventListener("pointermove", (event) => {
              const pointerEvent = event as PointerEvent;
              const bounds = card.getBoundingClientRect();
              const px = (pointerEvent.clientX - bounds.left) / bounds.width - 0.5;
              const py = (pointerEvent.clientY - bounds.top) / bounds.height - 0.5;
              card.style.transform =
                `perspective(1100px) rotateX(${(-py * max).toFixed(2)}deg) ` +
                `rotateY(${(px * max).toFixed(2)}deg) translateY(-0.4rem)`;
            });
            card.addEventListener("pointerleave", () => {
              card.style.transform = "";
            });
          });
        }
      }

      const consoleMessages = [
        "需求 Agent 正在分析 Issue，生成验收标准...",
        "物料整理完成，Spec 已生成，等待人工审核...",
        "Claude Code 编码完成，测试 Agent 验证中...",
        "安全审查通过，一键部署脚本已生成。"
      ];
      let messageIndex = 0;
      const consoleTime = document.querySelector(".console-time");
      const consoleCopy = document.querySelector(".console-copy");
      const liveRate = document.querySelector("[data-live-rate]");

      const formatLocalTime = () => {
        const now = new Date();
        return [
          String(now.getHours()).padStart(2, "0"),
          String(now.getMinutes()).padStart(2, "0"),
          String(now.getSeconds()).padStart(2, "0")
        ].join(":");
      };

      const briefMeta = document.querySelector(".brief-meta span:last-child");
      const updateClock = () => {
        const t = formatLocalTime();
        if (briefMeta) briefMeta.textContent = `${t} UTC+8`;
      };
      updateClock();
      window.setInterval(updateClock, 1000);

      if (!reducedMotion) {
        window.setInterval(() => {
          messageIndex = (messageIndex + 1) % consoleMessages.length;
          const copy = consoleMessages[messageIndex];
          if (consoleCopy instanceof HTMLElement) {
            consoleCopy.style.opacity = "0";
            consoleCopy.style.transform = "translateY(0.4rem)";
            window.setTimeout(() => {
              consoleCopy.textContent = copy;
              consoleCopy.style.opacity = "1";
              consoleCopy.style.transform = "translateY(0)";
            }, 220);
          }
          if (consoleTime) consoleTime.textContent = formatLocalTime();
        }, 3000);
        window.setInterval(() => {
          if (liveRate) liveRate.textContent = (17 + Math.random() * 3.4).toFixed(1);
        }, 1400);
      } else {
        if (consoleCopy) consoleCopy.textContent = consoleMessages[0];
        if (consoleTime) consoleTime.textContent = formatLocalTime();
      }

      const canvas = document.querySelector("#speed-field");
      if (canvas instanceof HTMLCanvasElement) {
        const context = canvas.getContext("2d");
        type Point = {
          x: number;
          y: number;
        };
        type Lane = {
          start: Point;
          controlA: Point;
          controlB: Point;
          end: Point;
          alpha: number;
          width: number;
          hue: number;
        };
        type Spark = {
          lane: number;
          progress: number;
          speed: number;
          tail: number;
          width: number;
          alpha: number;
          hue: number;
          glow: boolean;
        };

        const lanes: Lane[] = [];
        const sparks: Spark[] = [];
        let width = 0;
        let height = 0;
        let dpr = 1;
        let frame = 0;
        const baseOrigin = { x: 0, y: 0 };
        const camera = { x: 0, y: 0 };

        const randomBetween = (minimum: number, maximum: number) =>
          minimum + Math.random() * (maximum - minimum);

        const pointOnCurve = (lane: Lane, progress: number) => {
          const t = Math.max(0, Math.min(progress, 1));
          const inverse = 1 - t;
          const originInfluence = inverse * inverse;
          return {
            x:
              inverse ** 3 * lane.start.x +
              3 * inverse ** 2 * t * lane.controlA.x +
              3 * inverse * t ** 2 * lane.controlB.x +
              t ** 3 * lane.end.x +
              camera.x * originInfluence,
            y:
              inverse ** 3 * lane.start.y +
              3 * inverse ** 2 * t * lane.controlA.y +
              3 * inverse * t ** 2 * lane.controlB.y +
              t ** 3 * lane.end.y +
              camera.y * originInfluence
          };
        };

        const createLane = (index: number, count: number): Lane => {
          const ratio = index / Math.max(count - 1, 1);
          let end: Point;

          if (ratio < 0.5) {
            const spread = ratio / 0.5;
            end = {
              x: width * randomBetween(0.1 + spread * 0.65, 0.33 + spread * 0.9),
              y: height * randomBetween(0.82, 1.16)
            };
          } else if (ratio < 0.82) {
            end = {
              x: width * randomBetween(1.02, 1.2),
              y: height * randomBetween(0.22, 0.78)
            };
          } else {
            end = {
              x: width * randomBetween(0.18, 0.62),
              y: height * randomBetween(0.7, 1.08)
            };
          }

          const dx = end.x - baseOrigin.x;
          const dy = end.y - baseOrigin.y;
          const distance = Math.max(Math.hypot(dx, dy), 1);
          const normalX = -dy / distance;
          const normalY = dx / distance;
          const bend = randomBetween(-0.15, 0.15) * Math.min(width, height);

          return {
            start: { ...baseOrigin },
            controlA: {
              x: baseOrigin.x + dx * randomBetween(0.11, 0.2) + normalX * bend * 0.18,
              y: baseOrigin.y + dy * randomBetween(0.08, 0.16) + normalY * bend * 0.18
            },
            controlB: {
              x: baseOrigin.x + dx * randomBetween(0.55, 0.72) + normalX * bend,
              y: baseOrigin.y + dy * randomBetween(0.48, 0.68) + normalY * bend
            },
            end,
            alpha: randomBetween(0.035, 0.13),
            width: randomBetween(0.45, 1.15),
            hue: randomBetween(18, 34)
          };
        };

        const resetSpark = (spark: Spark, initial = false) => {
          spark.lane = Math.floor(Math.random() * lanes.length);
          spark.progress = initial ? Math.random() : randomBetween(-0.14, -0.02);
          spark.speed = randomBetween(0.0015, 0.0042);
          spark.tail = randomBetween(0.025, 0.11);
          spark.width = randomBetween(0.55, 2.25);
          spark.alpha = randomBetween(0.28, 0.92);
          spark.hue = randomBetween(20, 40);
          spark.glow = Math.random() > 0.74;
        };

        const resizeCanvas = () => {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          width = canvas.clientWidth;
          height = canvas.clientHeight;
          canvas.width = width * dpr;
          canvas.height = height * dpr;
          context?.setTransform(dpr, 0, 0, dpr, 0, 0);
          baseOrigin.x = width * (width < 760 ? 0.68 : 0.665);
          baseOrigin.y = height * (width < 760 ? 0.43 : 0.405);

          const laneCount = width < 760 ? 24 : 42;
          const sparkCount = width < 760 ? 54 : Math.min(118, Math.round(width / 15));
          lanes.length = 0;
          sparks.length = 0;
          for (let index = 0; index < laneCount; index += 1) {
            lanes.push(createLane(index, laneCount));
          }
          for (let index = 0; index < sparkCount; index += 1) {
            const spark = {} as Spark;
            resetSpark(spark, true);
            sparks.push(spark);
          }
        };

        const drawLane = (lane: Lane) => {
          if (!context) return;
          context.beginPath();
          context.moveTo(lane.start.x + camera.x, lane.start.y + camera.y);
          context.bezierCurveTo(
            lane.controlA.x + camera.x * 0.72,
            lane.controlA.y + camera.y * 0.72,
            lane.controlB.x + camera.x * 0.18,
            lane.controlB.y + camera.y * 0.18,
            lane.end.x,
            lane.end.y
          );
          context.strokeStyle = `hsla(${lane.hue}, 92%, 48%, ${lane.alpha})`;
          context.lineWidth = lane.width;
          context.stroke();
        };

        const drawSpark = (spark: Spark) => {
          if (!context || spark.progress <= 0) return;
          const lane = lanes[spark.lane];
          const segments = 12;
          const start = Math.max(0, spark.progress - spark.tail * (0.35 + spark.progress * 0.9));

          for (let segment = 0; segment < segments; segment += 1) {
            const fromProgress = start + (spark.progress - start) * (segment / segments);
            const toProgress = start + (spark.progress - start) * ((segment + 1) / segments);
            const from = pointOnCurve(lane, fromProgress);
            const to = pointOnCurve(lane, toProgress);
            const intensity = (segment + 1) / segments;
            context.beginPath();
            context.moveTo(from.x, from.y);
            context.lineTo(to.x, to.y);
            context.strokeStyle = `hsla(${spark.hue + intensity * 9}, 100%, ${48 + intensity * 28}%, ${
              spark.alpha * intensity ** 1.8
            })`;
            context.lineWidth = spark.width * (0.45 + intensity * 0.95) * (0.55 + spark.progress);
            context.lineCap = "round";
            context.stroke();
          }

          if (spark.glow && spark.progress > 0.35) {
            const head = pointOnCurve(lane, spark.progress);
            const radius = 2 + spark.progress * 5;
            const glow = context.createRadialGradient(head.x, head.y, 0, head.x, head.y, radius);
            glow.addColorStop(0, "rgba(255, 226, 184, 0.9)");
            glow.addColorStop(0.28, "rgba(255, 132, 36, 0.55)");
            glow.addColorStop(1, "rgba(255, 88, 0, 0)");
            context.fillStyle = glow;
            context.fillRect(head.x - radius, head.y - radius, radius * 2, radius * 2);
          }
        };

        const draw = () => {
          if (!context) return;
          context.clearRect(0, 0, width, height);
          camera.x += (pointerTarget.x * width * 0.025 - camera.x) * 0.035;
          camera.y += (pointerTarget.y * height * 0.018 - camera.y) * 0.035;

          const originX = baseOrigin.x + camera.x;
          const originY = baseOrigin.y + camera.y;
          const glow = context.createRadialGradient(originX, originY, 0, originX, originY, width * 0.48);
          glow.addColorStop(0, "rgba(255, 103, 10, 0.24)");
          glow.addColorStop(0.22, "rgba(164, 48, 0, 0.13)");
          glow.addColorStop(1, "rgba(0, 0, 0, 0)");
          context.fillStyle = glow;
          context.fillRect(0, 0, width, height);

          lanes.forEach(drawLane);
          sparks.forEach((spark) => {
            spark.progress += spark.speed * (0.22 + Math.max(spark.progress, 0) * 2.9);
            drawSpark(spark);
            if (spark.progress > 1.08) resetSpark(spark);
          });
          frame = requestAnimationFrame(draw);
        };

        resizeCanvas();
        window.addEventListener("resize", resizeCanvas);
        if (!reducedMotion) draw();
        else {
          draw();
          cancelAnimationFrame(frame);
        }
      }
    </script>
  </body>
</html>
