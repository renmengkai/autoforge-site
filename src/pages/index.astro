    <!-- JSON-LD structured data -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://autoforge.dev/#organization",
          "name": "AutoForge",
          "url": "https://autoforge.dev",
          "logo": {
            "@type": "ImageObject",
            "url": "https://autoforge.dev/autoforge-logo.png"
          },
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "renmengkai@gmail.com",
            "contactType": "sales",
            "availableLanguage": ["Chinese", "English"]
          },
          "description": "AutoForge is a human-gated autonomous software factory. It connects to any Git repository, uses Claude Code as its execution engine, and runs analysis, isolated implementation, testing, and security audit on a single auditable line. Two human gates — requirement review and code review — keep the merge decision in human hands."
        },
        {
          "@type": "WebSite",
          "@id": "https://autoforge.dev/#website",
          "url": "https://autoforge.dev",
          "name": "AutoForge",
          "description": "Human-gated autonomous software factory · Claude Code · Git worktree · Local-first",
          "publisher": { "@id": "https://autoforge.dev/#organization" },
          "inLanguage": ["zh-CN", "en"]
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://autoforge.dev/#software",
          "name": "AutoForge",
          "url": "https://autoforge.dev",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "macOS, Linux, Windows",
          "description": "AutoForge is a human-gated autonomous software factory and a local-first desktop application. It connects to any Git repository and uses Claude Code as its execution engine: requirements enter, are sanitized and analyzed, then — between two human review gates — Claude Code implements, tests, and audits each change inside an isolated Git worktree before a controlled merge. Software is priced per requirement, not per engineering hour.",
          "offers": {
            "@type": "Offer",
            "url": "https://autoforge.dev/#contact"
          },
          "featureList": [
            "Requirement intake via quick entry, meeting notes, GitHub / Webhook, and embeddable widget",
            "Blueprint Studio that turns ideas into PRDs, specs, and executable tasks",
            "Input sanitization treating external requirements and tool output as untrusted data (prompt-injection detection)",
            "Requirement-review gate (gate 1) before any implementation begins",
            "Autonomous implementation by Claude Code inside isolated Git worktrees",
            "Backpressure flow control and concurrency slots (default 5)",
            "Testing and security audit recorded as pipeline stages",
            "Code-review gate (gate 2) with change summary, diff, tests, and security results",
            "Controlled single-entry merge with full end-to-end trace",
            "Local-first: business state stays on the user's machine (SQLite, in-process scheduling)"
          ],
          "provider": { "@id": "https://autoforge.dev/#organization" }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is AutoForge?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "AutoForge is a human-gated autonomous software factory. It connects to any Git repository and uses Claude Code as its execution engine. Requirements enter, are sanitized and analyzed, then — between two human review gates — Claude Code implements, tests, and audits each change inside an isolated Git worktree before a controlled merge. It runs local-first as a desktop application, so one person can manage an AI factory."
              }
            },
            {
              "@type": "Question",
              "name": "What are the two human gates in AutoForge?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Gate 1 is requirement review: a human confirms the problem is real, the scope is clear, and the approach is worth doing. Gate 2 is code review: a human decides whether to merge by checking the change summary, diff, tests, and security results. Everything between the gates runs autonomously, and the final merge decision always stays with a human."
              }
            },
            {
              "@type": "Question",
              "name": "How does the AutoForge pipeline work?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The pipeline has eight stages: (1) Intake — quick entry, meeting notes, GitHub / Webhook, or widget, with dedup and priority analysis; (2) Sanitize — external input is treated as untrusted, with prompt-injection detection; (3) Analyze — an Agent breaks down the problem and drafts acceptance criteria; (4) Requirement Gate (human); (5) Implement — Claude Code works inside an isolated Git worktree; (6) Test & Audit — recorded testing and security stages; (7) Code Gate (human); (8) Merge — a single controlled entry point with a full trace."
              }
            },
            {
              "@type": "Question",
              "name": "Does AutoForge run in the cloud or locally?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "AutoForge is local-first. It runs as a desktop application with business state stored on your machine (SQLite and in-process scheduling), so there is no business server to deploy. Model data boundaries are determined by the Claude CLI or API you configure."
              }
            },
            {
              "@type": "Question",
              "name": "How does AutoForge keep autonomous execution safe?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Safety is a constraint across the whole line, not a final check. Each change runs in an isolated Git worktree; the agent layer intercepts dangerous Git operations and merges happen through a single controlled entry point; tests and security audits are recorded pipeline stages; external input is handled as untrusted data with prompt-injection detection; and agents, models, and tool calls are linked to one trace for full traceability."
              }
            }
          ]
        }
      ]
    }
    </script>
