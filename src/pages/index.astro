---
import "../styles/global.css";

const engines = [
  {
    index: "01",
    eyebrow: "REQUIREMENT INTAKE",
    title: "需求接入与蓝图",
    titleEn: "Intake & Blueprint",
    copy: "快速录入、会议材料、GitHub / Webhook 与嵌入式 Widget 多入口接入需求；蓝图工作室把大想法迭代成 PRD、规格与可执行任务，重复与优先级自动分析后统一进入需求池。",
    copyEn: "Bring requirements in via quick entry, meeting notes, GitHub / Webhook, or an embeddable widget. The Blueprint Studio turns big ideas into PRDs, specs, and executable tasks — with duplicate and priority analysis — before they enter one shared pool.",
    details: ["Widget / 会议材料 / GitHub / Webhook 多入口", "蓝图工作室 → PRD · 规格 · 可执行任务", "重复检测与优先级自动分析"],
    detailsEn: ["Widget / notes / GitHub / Webhook intake", "Blueprint Studio → PRD · spec · tasks", "Automatic dedup & priority analysis"],
    metric: "接入入口",
    metricEn: "Intake",
    value: "4"
  },
  {
    index: "02",
    eyebrow: "AUTONOMOUS EXECUTION",
    title: "隔离实现与自主运行",
    titleEn: "Isolated, Autonomous Execution",
    copy: "Claude Code 在独立 Git worktree 中完成实现、测试与安全审计，生成变更摘要与交付产物。背压式流控与并发槽位让长尾 backlog 稳定消化，不冲垮模型与系统。",
    copyEn: "Claude Code implements, tests, and audits inside an isolated Git worktree, producing a change summary and delivery artifacts. Backpressure flow control and concurrency slots keep the long-tail backlog moving without overloading the model or system.",
    details: ["每个变更在独立 worktree 中执行", "背压式流控 + 并发槽位（默认 5）", "变更摘要 + 测试 + 安全审计留痕"],
    detailsEn: ["Each change runs in its own worktree", "Backpressure + concurrency slots (default 5)", "Change summary + tests + audit on record"],
    metric: "并发槽位",
    metricEn: "Concurrency",
    value: "×5"
  },
  {
    index: "03",
    eyebrow: "TWO HUMAN GATES",
    title: "两道人工闸口",
    titleEn: "Two Human Gates",
    copy: "闸口 1 需求审核——确认问题真实、范围清楚、方案值得执行；闸口 2 代码审核——对照变更摘要、Diff、测试与安全结果决定是否合并。最终合并权始终留在人手中。",
    copyEn: "Gate 1, requirement review — confirm the problem is real, the scope clear, the approach worth doing. Gate 2, code review — decide whether to merge against the change summary, diff, tests, and security results. The final merge stays in human hands.",
    details: ["闸口 1 · 需求审核（要不要做）", "闸口 2 · 代码审核（做得对不对）", "双栏实现预览，逐项对比"],
    detailsEn: ["Gate 1 · requirement review (should we?)", "Gate 2 · code review (is it right?)", "Side-by-side implementation preview"],
    metric: "人工闸口",
    metricEn: "Gates",
    value: "2"
  }
];

const workflow = [
  ["01", "需求进入", "快速录入、会议材料、GitHub / Webhook 或 Widget 接入，自动做重复与优先级分析", "INTAKE", "Intake", "Quick entry, meeting notes, GitHub / Webhook, or widget — with automatic dedup and priority analysis."],
  ["02", "输入消毒", "外部需求、网页与工具返回值按不可信数据处理，检测明显的 Prompt Injection", "SANITIZE", "Sanitize", "External requirements, pages, and tool output are treated as untrusted data, with obvious prompt injection flagged."],
  ["03", "分析分流", "需求分析 Agent 拆解问题、生成验收标准，再分流到合适的处理路径", "ANALYZE", "Analyze", "The analysis Agent breaks down the problem, drafts acceptance criteria, and routes it to the right path."],
  ["04", "需求审核 · 闸口 1", "人工确认问题真实、范围清楚、方案值得执行后放行", "GATE · REQ", "Requirement Gate", "A human confirms the problem is real, the scope clear, and the approach worth doing before it passes."],
  ["05", "隔离实现", "Claude Code 在独立 worktree 中实现变更，生成变更摘要与交付产物", "IMPLEMENT", "Implement", "Claude Code implements the change in an isolated worktree, producing a change summary and artifacts."],
  ["06", "测试与审计", "测试 Agent 验证，功能与安全审计作为流水线阶段留痕，而不是口头承诺", "TEST · AUDIT", "Test & Audit", "A testing Agent verifies; functional and security audits are recorded pipeline stages, not verbal promises."],
  ["07", "代码审核 · 闸口 2", "对照变更摘要、Diff、测试与安全结果，决定是否合并", "GATE · CODE", "Code Gate", "Decide whether to merge against the change summary, diff, tests, and security results."],
  ["08", "合并交付", "通过单一受控入口合并，完整 trace 记录结果从何而来", "MERGE", "Merge", "Merge through a single controlled entry point, with a full trace of where every result came from."]
];

const metrics = [
  ["2 闸口", "需求审核与代码审核", "2 Gates", "Requirement & code review"],
  ["×5 并发", "默认隔离实现槽位", "×5 Slots", "Isolated runs by default"],
  ["100% 本地", "业务状态留在本机", "100% Local", "State stays on your machine"],
  ["1 个人", "管理整支 AI 工厂", "1 Operator", "Runs the whole factory"]
];

const pipeline = [
  ["01", "需求进入", "Intake", "IN"],
  ["02", "输入消毒", "Sanitize", "LINT"],
  ["03", "分析分流", "Analyze", "SCAN"],
  ["04", "需求审核", "Gate 1", "G1"],
  ["05", "隔离实现", "Implement", "CODE"],
  ["06", "测试审计", "Test", "TEST"],
  ["07", "代码审核", "Gate 2", "G2"],
  ["08", "合并交付", "Merge", "SHIP"]
];
