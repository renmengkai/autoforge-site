---
import "../styles/global.css";

const engines = [
  {
    index: "01",
    eyebrow: "REQUIREMENT INTELLIGENCE",
    title: "需求进入，自动成形",
    copy: "直接讨论需求、接入 GitHub Issue，或让 AI 扫描现有项目发现缺口。AutoForge 将零散输入整理为可执行、可验收的开发任务。",
    details: ["对话式需求确认", "Issue 自动同步", "AI 项目扫描与需求补全"],
    metric: "接入方式",
    value: "3"
  },
  {
    index: "02",
    eyebrow: "PROJECT CONTEXT",
    title: "项目上下文，集中管理",
    copy: "需求、设计稿、附件、参考资料、代码仓库和环境信息统一归档；开发规范、技术约束和验收规则成为 AI 持续遵守的项目记忆。",
    details: ["全量项目物料", "开发规范与技术约束", "跨任务上下文持续复用"],
    metric: "上下文",
    value: "ONE"
  },
  {
    index: "03",
    eyebrow: "AUTONOMOUS DELIVERY",
    title: "AI 开发，人类把关",
    copy: "AI 根据需求和项目规范生成代码，自主完成测试与安全审核。人类只在关键决策和合并节点轻量介入，随后生成预览并推进正式上线。",
    details: ["AI 自动完成需求开发", "人类轻在环审核", "测试、安全、预览与上线"],
    metric: "交付链路",
    value: "E2E"
  }
];

const workflow = [
  ["01", "确认需求", "通过讨论、Issue 或 AI 扫描明确目标与验收标准", "REQUIREMENT"],
  ["02", "汇集物料", "统一管理设计、附件、文档、链接与环境信息", "MATERIALS"],
  ["03", "加载规范", "读取项目开发规范、架构边界与质量约束", "CONTEXT"],
  ["04", "AI 开发", "理解现有代码并自动生成满足需求的实现", "DEVELOPMENT"],
  ["05", "人类审核", "在关键决策、风险与合并节点轻量介入", "REVIEW"],
  ["06", "自动验证", "执行测试、回归、安全扫描与质量审核", "QUALITY"],
  ["07", "预览上线", "生成项目预览，确认后部署到目标环境", "DELIVERY"]
];

const metrics = [
  ["3 种", "需求进入方式"],
  ["1 处", "管理全部项目上下文"],
  ["AI + 人", "轻在环开发审核"],
  ["全链路", "测试、安全、预览与上线"]
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
