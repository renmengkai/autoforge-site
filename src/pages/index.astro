---
import "../styles/global.css";

const engines = [
  {
    index: "01",
    eyebrow: "REQUIREMENT & MATERIALS",
    title: "需求收集与物料管理",
    copy: "通过 Agent 对话讨论、批量导入或需求分析专用 Agent 扫描来收集需求；多 Agent 群聊自动梳理，生成设计文档等全量项目物料。",
    details: ["Agent 对话 / 批量导入 / AI 扫描", "多 Agent 群聊整理项目物料", "自动生成设计文档与参考资料"],
    metric: "进入方式",
    value: "3"
  },
  {
    index: "02",
    eyebrow: "DESIGN & SPEC",
    title: "原型设计与 Spec 审查",
    copy: "集成 Open Design 自动生成提示词，复制至 Stitch 或 Claude Design 生成交互原型；AI 自动生成项目 Spec 与任务分解，人工审核后驱动编码精准落地。",
    details: ["OpenDesign 集成，提示词一键生成", "Stitch / Claude Design 原型输出", "AI 生成 Spec，人工审核确认"],
    metric: "设计工具",
    value: "3+"
  },
  {
    index: "03",
    eyebrow: "CODE · TEST · SHIP",
    title: "编码实现到部署上线",
    copy: "Claude Code CLI 自主完成编码；测试专用 Agent 全面验证，安全审计 Agent 审查代码；AI 生成一键部署 Shell 脚本，直达生产环境。",
    details: ["Claude Code CLI 自动编码", "测试 + 安全 Agent 双重审查", "AI Shell 脚本一键部署"],
    metric: "交付链路",
    value: "E2E"
  }
];

const workflow = [
  ["01", "需求收集", "通过 Agent 对话、批量导入或 AI 扫描，明确需求目标与验收标准", "REQUIREMENT"],
  ["02", "物料管理", "多 Agent 群聊自动梳理，生成设计文档等全量项目物料", "MATERIALS"],
  ["03", "原型设计", "OpenDesign 生成提示词，复制至 Stitch 或 Claude Design 完成交互原型", "PROTOTYPE"],
  ["04", "Spec 审查", "AI 生成项目规范与任务分解，人工审核后锁定编码目标", "SPEC"],
  ["05", "编码实现", "Claude Code CLI 理解 Spec 与代码库，自主完成功能开发", "DEVELOPMENT"],
  ["06", "系统测试", "测试专用 Agent 全面验证，可将新发现的问题直接录入为需求", "TESTING"],
  ["07", "安全审查", "安全审计专用 Agent 扫描代码，确保合规与安全边界清晰", "SECURITY"],
  ["08", "部署上线", "AI 生成稳定 Shell 脚本，一键部署到目标生产环境", "DELIVERY"]
];

const metrics = [
  ["8 节点", "覆盖完整交付链路"],
  ["3 种", "需求进入方式"],
  ["AI + 人", "轻量在环审核"],
  ["全替代", "外包依赖归零"]
];
